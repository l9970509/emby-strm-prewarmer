#!/bin/bash
# 应用设置变更后：把向导里改过的值写进 config.json，再重启服务

DIR="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="${TRIM_APPDEST}/prewarmer"
CONF="${TRIM_PKGETC}/config.json"
LOG_DIR="${TRIM_PKGVAR}/logs"

mkdir -p "${TRIM_PKGETC}" "${TRIM_PKGVAR}" "${LOG_DIR}"

python3 "${APP_DIR}/app/bootstrap.py" --config "${CONF}" --port 8799 >> "${LOG_DIR}/config.log" 2>&1
if [ $? -ne 0 ]; then
    echo "配置保存失败，请查看日志：${LOG_DIR}/config.log" >"${TRIM_TEMP_LOGFILE}"
    exit 1
fi

bash "${DIR}/main" restart
exit $?
